# Copy to .env on the server (docs/06-deploy-oracle.md). Never commit the real file.
ENV=prod
DEV_LOGIN=false

# Public address; DNS must point at the server. Free option: yourname.duckdns.org
DOMAIN=qb.example.com
WEB_APP_URL=https://qb.example.com
CORS_ORIGINS=["https://qb.example.com"]

# Generate:  openssl rand -hex 32   (JWT)   and   openssl rand -hex 24   (database)
JWT_SECRET=
POSTGRES_PASSWORD=

# E-mail sign-in codes (resend.com: API key + a sender on a verified domain)
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=QB <no-reply@qb.example.com>

# Optional sign-in methods; buttons appear when set
GOOGLE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# TIN lookup at sign-up: "eregister" = public company search of e-register.moj.am (real companies),
# "none" = manual entry only, "demo" = fictional companies (never for real users).
REGISTRY_PROVIDER=eregister

# Monitoring (docs/06-deploy-oracle.md, section 6). Unexpected server errors are e-mailed here (needs resend).
ALERT_EMAIL=
# healthchecks.io checks: the scheduler pings every minute; the backup pings after each run
HEALTHCHECK_PING_URL=
BACKUP_PING_URL=
# Backups outside this machine, an rclone target (e.g. Oracle Object Storage "oci:qb-backups"); days to keep
BACKUP_REMOTE=
BACKUP_REMOTE_DAYS=60
