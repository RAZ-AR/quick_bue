# --- core ---
ENV=dev
# Database password (compose); use hex, it goes into DATABASE_URL: openssl rand -hex 24
POSTGRES_PASSWORD=qb
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=["http://localhost:5180"]
# Used when running the backend outside docker; compose overrides these for containers
DATABASE_URL=postgresql+asyncpg://qb:qb@localhost:5435/qb
REDIS_URL=redis://localhost:6381/0
WEB_APP_URL=http://localhost:8090

# --- auth ---
# Local testing only: sign in as a seeded user by email (python -m app.seed)
DEV_LOGIN=true
# Bot token from @BotFather (bot profile: docker compose --profile bot up -d)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# "Sign in with Telegram" also needs the site domain set in @BotFather: /setdomain
# Google sign-in: OAuth 2.0 Web client ID (Google Cloud Console → Credentials); add the site URL to authorized origins
GOOGLE_CLIENT_ID=
# E-mail login codes: console = code is printed to the api log (and shown on screen while DEV_LOGIN=true)
MAIL_PROVIDER=console
# MAIL_PROVIDER=resend: API key from resend.com and a sender on a verified domain
RESEND_API_KEY=
MAIL_FROM=QB <no-reply@example.com>
